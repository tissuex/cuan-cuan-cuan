# Provider AI: "google" (Google AI Studio) atau "anthropic" (Claude)
AI_PROVIDER=google

# Google AI Studio API Key (wajib jika AI_PROVIDER=google)
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic API Key (wajib jika AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Nama model vision (tidak di-hardcode; ganti sesuai provider Anda)
# Contoh Google AI Studio: gemini-3-flash-preview, gemini-3.5-flash, gemini-3.1-pro-preview
# Contoh Anthropic: claude-sonnet-4-5, claude-3-7-sonnet-latest
MODEL_NAME=gemini-3-flash-preview

# Opsional: Password tunggal untuk mengunci akses API & antarmuka web (kosongkan jika publik/lokal)
APP_PASSWORD=

# Opsional: Upstash Redis untuk rate limiting terdistribusi di Vercel
# Jika dikosongkan, aplikasi otomatis menggunakan rate limiter in-memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsional (untuk APK Android / Capacitor): Daftar origin CORS tambahan yang diizinkan memanggil /api/*
# Pisahkan dengan koma jika lebih dari satu. Origin Capacitor (https://localhost, capacitor://localhost)
# dan domain Vercel (VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL) otomatis diizinkan.
ALLOWED_ORIGINS=

